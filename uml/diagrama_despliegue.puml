@startuml DiagramaDespliegue
!pragma layout elk

title Diagrama de Despliegue - Capit@l Humano

skinparam shadowing false
skinparam roundcorner 6
skinparam DefaultFontName "Roboto"
skinparam DefaultFontSize 12
skinparam ArrowColor #333333
skinparam node {
    BackgroundColor #FFFFFF
    BorderColor #424242
    BackgroundColor<<device>> #F7F7F7
    BackgroundColor<<container>> #EFF4F8
}
skinparam artifact {
    BackgroundColor #FFF8E1
    BorderColor #E65100
    BackgroundColor<<deployment spec>> #F3E5F5
    BorderColor<<deployment spec>> #6A1B9A
}

' ==========================================
' CLIENTES
' ==========================================
node "PC del Consultor" <<device>> as pcConsultor {
    node "Navegador web" <<executionEnvironment>> as navConsultor
}

node "PC del Candidato" <<device>> as pcCandidato {
    node "Navegador web" <<executionEnvironment>> as navCandidato
}

node "Impresora" <<device>> as impresora

' ==========================================
' SERVIDOR DE LA CONSULTORA
' ==========================================
node "Servidor de aplicaciones" <<device>> as servidor {

    node "Node.js / Vite" <<executionEnvironment>> as vite {
        artifact "frontend\n(SPA React 19) :3000" as spa
        artifact ".env (front)" <<deployment spec>> as envFront
    }

    node "JRE 21" <<executionEnvironment>> as jre {
        artifact "capitalhumano.jar\n(Spring Boot 4.1, Tomcat embebido) :8080" as jar
        artifact "application.properties\n.env (back)" <<deployment spec>> as appProps
    }

    node "Docker Engine" <<executionEnvironment>> as docker {
        artifact "compose.yaml" <<deployment spec>> as compose

        node "capitalhumano_postgres" <<container>> as cDb {
            node "postgres:16-alpine" <<executionEnvironment>> as pg {
                artifact "01-init.sql" as sql
            }
        }

        node "capitalhumano_ldap" <<container>> as cLdap {
            node "osixia/openldap:1.5.0" <<executionEnvironment>> as ldap {
                artifact "consultores.ldif" as ldif
            }
        }
    }
}

' ==========================================
' SISTEMAS EXTERNOS
' ==========================================
node "Servicio de IA (externo)" <<device>> as srvIA {
    node "Google Gemini API" <<executionEnvironment>> as apiIA
}

node "Servidor del Sistema de Gestion\nde Candidatos y CV" <<device>> as srvCV {
    node "Sistema de Gestion de Candidatos y CV" <<executionEnvironment>> as sistCV
}

' ==========================================
' CAMINOS DE COMUNICACION
' ==========================================
' El navegador descarga la SPA desde Vite y, una vez cargada,
' la SPA invoca directamente a la API REST del backend
pcConsultor "1..*" -- "1" spa : <<HTTP>>
pcConsultor "1..*" -- "1" jar : <<HTTP / REST + cookie JWT>>
pcCandidato "1..*" -- "1" spa : <<HTTP>>
pcCandidato "1..*" -- "1" jar : <<HTTP / REST + cookie JWT>>
jar "1" -- "1" cDb : <<JDBC>>
jar "1" -- "1" cLdap : <<LDAP>>
jar "1" -- "1" srvIA : <<HTTPS>>
impresora "1" -- "1..*" pcConsultor : <<USB / TCP-IP>>
srvCV "1" -- "1..*" pcConsultor : <<archivo CSV>>

' Especificaciones de despliegue
envFront ..> spa
appProps ..> jar
compose ..> cDb
compose ..> cLdap

@enduml
