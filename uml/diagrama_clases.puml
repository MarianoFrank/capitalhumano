        + nombrePuesto: String
        + nombreEmpresa: String
        + totalCandidatos: int
        + evaluacionesCompletadas: int
    }

    class "EvaluacionDTO.Generar" as EvaluacionDTO_Generar <<DTO>> {
        + idPuesto: Long
        + idsCandidatos: List<Long>
    }

    class "EvaluacionDTO.ClaveGenerada" as EvaluacionDTO_ClaveGenerada <<DTO>> {
        + numeroCandidato: String
        + nombre: String
        + apellido: String
        + claveAcceso: String
    }

    class "EvaluacionDTO.Resumen" as EvaluacionDTO_Resumen <<DTO>> {
        + id: Long
        + descripcion: String
    }

    class "EvaluacionDTO.ReporteOrdenMerito" as EvaluacionDTO_ReporteOrdenMerito <<DTO>> {
        + nombreEmpresa: String
        + nombrePuesto: String
        + emitidoPor: String
        + fechaEmision: LocalDateTime
        + candidatosAprobados: List<EvaluacionDTO.ReporteCandidato>
        + candidatosRechazadosOIncompletos: List<EvaluacionDTO.ReporteCandidato>
        + {static} from(puesto: Puesto, consultor: String, fechaEmision: LocalDateTime, aprobados: List<ReporteCandidato>, noAprobados: List<ReporteCandidato>): ReporteOrdenMerito
    }

    class "EvaluacionDTO.ReporteCandidato" as EvaluacionDTO_ReporteCandidato <<DTO>> {
        + nombre: String
        + apellido: String
        + tipoDocumento: String
        + numeroDocumento: String
        + numeroCandidato: String
        + estado: String
        + puntaje: Double
        + fechaInicio: LocalDateTime
        + fechaFin: LocalDateTime
        + cantidadAccesos: Integer
        + {static} from(cuestionario: Cuestionario): ReporteCandidato
    }

    class "CuestionarioDTO.Inicio" as CuestionarioDTO_Inicio <<DTO>> {
        + idCuestionario: Long
        + totalBloques: int
        + bloqueActual: int
        + duracionMinutos: int
        + estado: String
        + fechaInicio: LocalDateTime
    }

    class "CuestionarioDTO.Bloque" as CuestionarioDTO_Bloque <<DTO>> {
        + id: Long
        + itemsPregunta: List<CuestionarioDTO.ItemPregunta>
    }

    class "CuestionarioDTO.ItemPregunta" as CuestionarioDTO_ItemPregunta <<DTO>> {
        + id: Long
        + ordenVisualizacion: int
        + texto: String
        + esMultiple: boolean
        + itemsOpcion: List<CuestionarioDTO.ItemOpcion>
    }

    class "CuestionarioDTO.ItemOpcion" as CuestionarioDTO_ItemOpcion <<DTO>> {
        + id: Long
        + ordenVisualizacion: int
        + texto: String
        + estaRespondida: Boolean
    }

    class ApiErrorResponse <<DTO>> {
        + timestamp: LocalDateTime
        + status: Integer
        + error: String
        + message: String
        + path: String
        + validationErrors: Map<String, String>
    }

    class CuestionarioCompletadoEvent <<DTO>> {
        + idCuestionario: Long
    }

    note as NotaDTOs
        <b>Criterio de Modelado:</b>
        Solo se modelaron los DTO que por el momento consideramos
        más relevantes en cuanto a decisiones de diseño, ya que
        los de detalle, resumen o altas se pueden deducir e interpretar.
    end note

}

' ==========================================
' ENTIDADES DE DOMINIO
' ==========================================
package "Dominio" {

    interface Auditable {
        + getIdentificadorAuditoria(): Long
        + getTipoEntidad(): String
    }

    class RegistroAuditoria {
        - fechaHora: DateTime
        - tipoEntidad: String
        - idEntidadEliminada: Long
        - descripcion: String
    }

    note bottom of RegistroAuditoria
      <b>Decisión de Diseño sobre 'tipoEntidad' (String vs Enum):</b>
      Se modela como <b>String</b> en lugar de un <b>Enum</b> por:
      • <b>Desacoplamiento y OCP (Principio Abierto/Cerrado):</b>
        La auditoría es un módulo transversal. Al usar un String, el sistema puede comenzar
        a auditar nuevas entidades dinámicamente sin la necesidad de modificar y recompilar
        una enumeración centralizada cada vez que el modelo de dominio crece.
    end note

    class Consultor {
        - username: String
    }

    class Candidato {
        - numeroCandidato: Long
        - tipoDocumento: TipoDocumento
        - numeroDocumento: String
        - nombre: String
        - apellido: String
        - fechaNacimiento: LocalDate
        - genero: Genero
        - email: String
        - escolaridad: String
        - nacionalidad: String
    }

    class Empresa {
        - nombre: String
        - fechaBaja: LocalDateTime
    }

    class Puesto {
        - codigo: String
        - nombre: String
        - descripcion: String
        - fechaBaja: LocalDateTime
    }

    class PuestoCompetencia {
        - ponderacionRequerida: Integer
    }

    class Competencia {
        - codigo: String
        - nombre: String
        - descripcion: String
        - tipo: TipoCompetencia
        - fechaBaja: LocalDateTime
    }

    class Factor {
        - codigo: String
        - nombre: String
        - descripcion: String
        - numeroOrden: Integer
        - fechaBaja: LocalDateTime
    }

    class Pregunta {
        - version: Integer
        - nombre: String
        - texto: String
        - descripcion: String
        - tipo: TipoPregunta
        - fechaModificacion: LocalDateTime
        - fechaBaja: LocalDateTime
        + Pregunta()
        + getOpciones(): List<Opcion>
        + setFactor(factor: Factor): void
        + setNombre(nombre: String): void
        + setTexto(texto: String): void
        + setTipo(tipo: TipoPregunta): void
    }

    class Opcion {
        - ordenVisualizacion: Integer
        - ponderacion: Integer
        - texto: String
        + Opcion()
    }

    class Evaluacion {
        - codigo: String
        - fechaCreacion: LocalDateTime
        - fechaCierre: LocalDateTime
        - duracion: Integer
        - cantPreguntasPorBloque: Integer
        + Evaluacion()
        + setCodigo(codigo: String): void
        + setPuesto(puesto: Puesto): void
        + setConsultor(consultor: Consultor): void
        + setDuracion(duracion: Integer): void
        + setCantPreguntasPorBloque(cantPreguntasPorBloque: Integer): void
    }

    class Cuestionario {
        - claveAcceso: String
        - fechaInicio: LocalDateTime
        - fechaFin: LocalDateTime
        - ultimoAcceso: LocalDateTime
        - cantidadAccesos: Integer
        - puntajeTotal: Double
        - estado: EstadoCuestionario
        + Cuestionario()
        + getPuntajesCompetencias(): List<PuntajeCompetencia>
        + setEvaluacion(evaluacion: Evaluacion): void
        + setCandidato(candidato: Candidato): void
        + setClaveAcceso(claveAcceso: String): void
        + setEstado(estado: EstadoCuestionario): void
        + setFechaInicio(fechaInicio: LocalDateTime): void
        + setFechaFin(fechaFin: LocalDateTime): void
        + setCantidadAccesos(cantidadAccesos: Integer): void
        + setUltimoAcceso(ultimoAcceso: LocalDateTime): void
        + setPuntajeTotal(puntajeTotal: Double): void
    }

    class Bloque {
        - numeroBloque: Integer
        + Bloque()
    }

    class ItemPregunta {
        - ordenVisualizacion: Integer
        - puntajeObtenido: Double
        + ItemPregunta()
    }

    class ItemOpcion {
        - estaRespondida: Boolean
        + ItemOpcion()
        + setEstaRespondida(estaRespondida: Boolean): void
    }

    class PuntajeCompetencia {
        - puntaje: Double
        + PuntajeCompetencia()
        + getPuntajesFactores(): List<PuntajeFactor>
        + setPuntaje(puntaje: Double): void
    }

    class PuntajeFactor {
        - puntaje: Double
        + PuntajeFactor()
        + setFactor(factor: Factor): void
        + setPuntaje(puntaje: Double): void
    }
}

