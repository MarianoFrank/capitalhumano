' ==========================================
' SERVICIOS DEL SISTEMA (Lógica de Negocio)
' ==========================================
package "Servicios del Sistema" {

    class SecurityService <<Servicio>> {
        + autenticarConsultor(usuario: String, contrasenia: String): Map<String, Object>
        + autenticarCandidato(peticion: CandidatoDTO.IniciarSesion): Map<String, Object>
        + obtenerPerfilUsuario(nombrePrincipal: String, rol: String): Object
        + esPropietarioCuestionario(idCuestionario: Long): Boolean
    }

    class JwtService <<Servicio>> {
        + generarToken(nombreUsuario: String, rol: String): String
        + generarJwtCookie(jwt: String): ResponseCookie
        + obtenerCleanJwtCookie(): ResponseCookie
        + extraerNombreUsuario(token: String): String
        + extraerRol(token: String): String
        + esTokenValido(token: String): boolean
    }

    class LdapService <<Servicio>> {
        + esUsuarioActivo(nombreUsuario: String): boolean
        + obtenerPerfilUsuario(nombreUsuario: String): Map<String, Object>
    }

    class CandidatoService <<Servicio>> {
        + obtenerCandidatosPaginados(nombre: String, apellido: String, numeroCandidato: Long, pageable: Pageable): Page<CandidatoDTO.Resumen>
        + procesarCandidatosCsv(file: MultipartFile): List<CandidatoDTO.Resumen>
        + buscarPorNumeroDocumento(nroDocumento: String): Candidato
    }

    class CompetenciaService <<Servicio>> {
        + listarCompetencias(codigo: String, nombre: String, pageable: Pageable): Page<CompetenciaResumenDTO>
        + obtenerCompetenciasParaSelect(): List<ComunDTO.ItemSeleccion>
        + darDeAltaCompetencia(datos: AltaCompetenciaDTO): Competencia
        + modificarCompetencia(id: Long,datos: AltaCompetenciaDTO): Competencia
        + darDeBajaCompetencia(id: Long): void
    }
    note top of CompetenciaService
        <b>Regla de Negocio (Baja Lógica):</b>
        Permite edición de textos (nombre, descripción).
        Para cambios estructurales (ej. Tipo, Factores asociados),
        se bloquea la edición y se exige dar de baja la actual
        para crear una nueva (salvo que la competencia aún
        no posea evaluaciones históricas asociadas).
    end note

    class FactorService <<Servicio>> {
        + listarFactores(idCompetencia: Long, pageable: Pageable): Page<FactorResumenDTO>
        + obtenerFactoresParaSelect(idCompetencia: Long): List<ComunDTO.ItemSeleccion>
        + darDeAltaFactor(datos: AltaFactorDTO): Factor
        + modificarFactor(id: Long,datos: AltaFactorDTO): Factor
        + darDeBajaFactor(id: Long): void
    }
    note top of FactorService
        <b>Regla de Negocio (Baja Lógica):</b>
        Aplica la misma política de integridad que Competencia.
        Modificaciones estéticas permitidas; cambios estructurales
        requieren baja y nueva alta. Es válido agregar nuevas
        preguntas asociadas.
    end note

    class PuestoService <<Servicio>> {
        + listarPuestos(codigo: String, nombre: String, idEmpresa: Long, pageable: Pageable): Page<PuestoResumenDTO>
        + obtenerPuestosParaSelect(): List<PuestoDTO.Seleccion>
        + buscarPuesto(id: Long): PuestoDetalleDTO
        + darDeAltaPuesto(datos: AltaPuestoDTO): PuestoDetalleDTO
        + modificarPuesto(id: Long, datos: AltaPuestoDTO): PuestoDetalleDTO
        + darDeBajaPuesto(id: Long): void
        - validarPonderaciones(caracteristicas: List<CompetenciaPuestoDTO>): void
        - validarPuestoSinEvaluaciones(idPuesto: Long): void
    }
    note right of PuestoService::modificarPuesto
        <b>Regla de Negocio (Bloqueo por uso):</b>
        Se permite modificar datos descriptivos. Sin embargo,
        el método <b>validarPuestoSinEvaluaciones</b> bloquea la modificación
        de competencias o ponderaciones si ya posee evaluaciones asociadas.
    end note

    class PreguntaService <<Servicio>> {
        + obtenerTodasLasPreguntasResumen(idCompetencia: Long, idFactor: Long, nombrePregunta: String, pageable: Pageable): Page<PreguntaDTO.Resumen>
        + obtenerPreguntaPorId(id: Long): PreguntaDTO.Detalle
        + crearPregunta(peticion: PreguntaDTO.Guardar): PreguntaDTO.Detalle
        + actualizarPregunta(id: Long, peticion: PreguntaDTO.Guardar): PreguntaDTO.Detalle
        + eliminarPregunta(id: Long): void
        - validarPreguntaNoDuplicada(idFactor: Long, nombre: String, texto: String, idExcluir: Long): void
        - validarPonderacionesOpciones(opciones: List<PreguntaDTO.OpcionGuardar>): void
    }
    note right of PreguntaService
        <b>Regla de Negocio (Versionado):</b>
        Las opciones se gestionan a través de la Pregunta. Si se
        modifica una pregunta/opción ya utilizada en un cuestionario,
        el sistema crea automáticamente una nueva versión de la misma.
    end note

    class EvaluacionService <<Servicio>> {
        + validarCandidatosDisponibles(idsCandidatos: List<Long>): void
        - validarCompetenciasEvaluables(puesto: Puesto): void
        + generarEvaluacion(peticion: EvaluacionDTO.Generar): List<EvaluacionDTO.ClaveGenerada>
        + generarEstructuraCuestionario(cuestionario: Cuestionario, puesto: Puesto): void
        - seleccionarPreguntasParaPuesto(puesto: Puesto): List<Pregunta>
        - armarBloquesCuestionario(cuestionario: Cuestionario, preguntasSeleccionadas: List<Pregunta>, porBloque: int): void
        - generarClaveAccesoUnica(): String
    }

    class CuestionarioService <<Servicio>> {
        + iniciarCuestionario(idCuestionario: Long): CuestionarioDTO.Inicio
        + obtenerBloque(idCuestionario: Long, numeroBloque: int): CuestionarioDTO.Bloque
        - calcularBloqueActual(cuestionario: Cuestionario): int
        + guardarRespuestasBloque(idCuestionario: Long, numeroBloque: int, respuestas: Map<Long, List<Long>>): void
        + finalizarPorTiempoAgotado(idCuestionario: Long): void
        - validarDisponibilidadYCerrarSiVencio(cuestionario: Cuestionario, ahora: LocalDateTime, validarMaxAccesos: boolean): void
        + finalizarCuestionariosVencidos(): void
    }
    note right of CuestionarioService
      <b>Decisiones de Implementación (Spring Boot):</b>
      • <b>iniciarCuestionario:</b> Si el cuestionario no tiene bloques, genera su estructura.
      • <b>guardarRespuestasBloque:</b> Al completar el último bloque publica
        CuestionarioCompletadoEvent; PuntajeAsyncService calcula los puntajes
        en forma asincrónica (AFTER_COMMIT + @Async).
      • <b>finalizarCuestionariosVencidos:</b> Lo invoca CuestionarioVencimientoScheduler (cron 00:00).
    end note

    class CuestionarioVencimientoScheduler <<Servicio>> {
        + <<Scheduled>> procesarCuestionariosVencidos(): void
    }

    class PuntajeAsyncService <<Servicio>> {
        + <<Async>> calcularPuntajesAsync(event: CuestionarioCompletadoEvent): void
        + calcularPuntajeSincrono(idCuestionario: Long): Double
    }

    class ReporteService <<Servicio>> {
        + generarOrdenMerito(idPuesto: Long, idEvaluacion: Long): EvaluacionDTO.ReporteOrdenMerito
        - esCandidatoAprobado(cuestionario: Cuestionario, puesto: Puesto): boolean
        + obtenerPuestosParaReporte(idEmpresa: Long, nombrePuesto: String, codigo: String, pageable: Pageable): Page<PuestoDTO.Resumen>
        + obtenerResumenEvaluacionesPorPuesto(idPuesto: Long): List<EvaluacionDTO.Resumen>
        + emitirReporteComparativo(idEvaluacion: Long, idCandidato: Long): ReporteComparativoDTO
        - calcularComparativaCompetencias(cuestionario: Cuestionario, puesto: Puesto): List<ComparativaCompetenciaDTO>
    }

    class EmpresaService <<Servicio>> {
        + obtenerEmpresasParaSelect(): List<ComunDTO.ItemSeleccion>
    }

    class IaGeneracionService <<Servicio>> {
        + generarPregunta(peticion: PreguntaDTO.IaPeticion): PreguntaDTO.IaRespuesta
    }

    class ServicioAuditoria <<Servicio>> {
        + registrarBaja(entidad: Auditable): void
    }
}

' ==========================================
' ACCESO A DATOS (DAOs / Repositorios)
' ==========================================
package "Acceso a Datos (DAOs)" {

    interface "JpaRepository<T, ID>" as DAO <<DAO>> {
        + findById(id: ID): Optional<T>
        + findAll(): List<T>
        + save(entidad: T): T
        + saveAll(entidades: List<T>): List<T>
        + delete(entidad: T): void
        + deleteById(id: ID): void
        + existsById(id: ID): boolean
        + count(): long
    }
    note top of DAO
        Las implementaciones de los repositorios las
        genera Spring Data JPA en tiempo de ejecución.
    end note

    interface CandidatoRepository <<DAO>> {
        + findByNumeroCandidato(numeroCandidato: Long): Optional<Candidato>
        + findByNumeroDocumento(numeroDocumento: String): Optional<Candidato>
        + findByNumeroCandidatoIn(numerosCandidatos: List<Long>): List<Candidato>
        + buscarConFiltros(nombre: String, apellido: String, numeroCandidato: Long, pageable: Pageable): Page<Candidato>
    }

    interface EvaluacionRepository <<DAO>> {
        + findByPuestoId(puestoId: Long): List<Evaluacion>
    }

    interface CuestionarioRepository <<DAO>> {
        + findByClaveAcceso(claveAcceso: String): Optional<Cuestionario>
        ' --- Consultas para Orden de Merito ---
        + findByEvaluacionId(evaluacionId: Long): List<Cuestionario>
        + findByEvaluacionPuestoId(puestoId: Long): List<Cuestionario>
        + findByCandidatoIdInAndEstadoIn(idsCandidatos: List<Long>, estados: List<EstadoCuestionario>): List<Cuestionario>
        + findByEstadoIn(estados: List<EstadoCuestionario>): List<Cuestionario>
        ' --- para Reporte Comparativo ---
        + buscarPorEvaluacionYCandidato(idEval: Long, idCandidato: Long): Cuestionario
        + findExpiredQuestionnaires(now: LocalDateTime, states: List<EstadoCuestionario>): List<Cuestionario>
    }

    interface PreguntaRepository <<DAO>> {
        + buscarConFiltros(idCompetencia: Long, idFactor: Long, nombre: String, pageable: Pageable): Page<Pregunta>
        + findByIdAndFechaBajaIsNull(id: Long): Optional<Pregunta>
        + existsByFactorIdAndNombreIgnoreCaseAndFechaBajaIsNull(factorId: Long, nombre: String): boolean
        + existsByFactorIdAndTextoIgnoreCaseAndFechaBajaIsNull(factorId: Long, texto: String): boolean
        + existsByFactorIdAndNombreIgnoreCaseAndFechaBajaIsNullAndIdNot(factorId: Long, nombre: String, id: Long): boolean
        + existsByFactorIdAndTextoIgnoreCaseAndFechaBajaIsNullAndIdNot(factorId: Long, texto: String, id: Long): boolean

        ' --- Para generar exámenes ---
        + findActiveByFactorId(factorId: Long): List<Pregunta>

        ' para validar si esta siendo usada en un cuestionario si se quiere modificar (versionado)
        + estaEnUso(id: Long): Boolean
    }

    interface PuestoRepository <<DAO>> {
        + buscarFiltrado(codigo: String, nombre: String, idEmpresa: Long, pageable: Pageable): Page<Puesto>
        + findAllActivePositions(): List<Puesto>
        + buscarParaReporte(idEmpresa: Long, nombre: String, codigo: String, pageable: Pageable): Page<Puesto>
    }

    interface CompetenciaRepository <<DAO>> {
        ' competencias que tienen al menos un factor con 2 o más preguntas activas
        ' para comparar con las competencias al momento de emitir evaluacion para un puesto (no se puede emitir si las comp. no son validas)
        + findValidCompetencyIds(): List<Long>
        + findByFechaBajaIsNullOrderByNombreAsc(): List<Competencia>
    }

    interface FactorRepository <<DAO>> {
        + findByFechaBajaIsNullOrderByNombreAsc(): List<Factor>
        + findByCompetenciaIdAndFechaBajaIsNullOrderByNombreAsc(competenciaId: Long): List<Factor>
    }

    interface EmpresaRepository <<DAO>> {
        + findByFechaBajaIsNullOrderByNombreAsc(): List<Empresa>
    }

    interface ConsultorRepository <<DAO>> {
        + findByUsername(username: String): Optional<Consultor>
    }

    interface AuditoriaDAO <<DAO>> {
        + buscarPorEntidad(tipoEntidad: String): List<RegistroAuditoria>
    }
}

