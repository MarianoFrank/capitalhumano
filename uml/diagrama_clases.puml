@startuml
!pragma layout elk
scale max 4000 width

' ==========================================
' CONFIGURACIONES VISUALES Y ESTILOS
' ==========================================
left to right direction
skinparam shadowing false
skinparam roundcorner 8
skinparam nodesep 40
skinparam ranksep 60
skinparam classAttributeIconSize 0
skinparam DefaultFontName "Roboto"
skinparam DefaultFontSize 13
skinparam packageStyle rectangle

' Estilos diferenciados por estereotipo
skinparam class {
    BackgroundColor White
    ArrowColor #333333
    BorderColor #555555
}
skinparam class<<Servicio>> {
    BackgroundColor #E8F5E9
    BorderColor #2E7D32
    HeaderBackgroundColor #C8E6C9
}
skinparam interface<<DAO>> {
    BackgroundColor #FFF3E0
    BorderColor #E65100
    HeaderBackgroundColor #FFE0B2
}
skinparam class<<DAO>> {
    BackgroundColor #FFF8E1
    BorderColor #E65100
    HeaderBackgroundColor #FFE0B2
}
skinparam class<<DTO>> {
    BackgroundColor #F3E5F5
    BorderColor #6A1B9A
    HeaderBackgroundColor #E1BEE7
}
skinparam class<<Controller>> {
    BackgroundColor #E3F2FD
    BorderColor #1565C0
    HeaderBackgroundColor #BBDEFB
}
skinparam class<<View>> {
    BackgroundColor #FAFAFA
    BorderColor #616161
    HeaderBackgroundColor #E0E0E0
}
skinparam class{
    BackgroundColor #FFFFFF
    BorderColor #424242
    HeaderBackgroundColor #EEEEEE
}

' ==========================================
' ENUMERACIONES
' ==========================================
package "Enumeraciones" {
    enum EstadoCuestionario {
        ACTIVO
        EN_PROCESO
        COMPLETADO
        INCOMPLETO
        SIN_CONTESTAR
        -- En Backend Java --
        ACTIVE
        IN_PROGRESS
        COMPLETED
        INCOMPLETE
        NOT_ANSWERED
    }
    enum TipoDocumento {
        DNI
        LE
        LC
        PP
    }
    enum TipoPregunta {
        OPCION_SIMPLE
        OPCION_MULTIPLE
        -- En Backend Java --
        SINGLE_CHOICE
        MULTIPLE_CHOICE
    }
    enum TipoCompetencia {
        TECNICA
        ACTITUDINAL
        -- En Backend Java --
        TECNICA
        CONDUCTUAL
    }
    enum Genero {
        H
        M
    }
}

' ==========================================
' CAPA DE PRESENTACIÓN (Vistas y Controladores)
' ==========================================
package "Capa de Presentación" {

    class GestionarPreguntasView <<View>> {
