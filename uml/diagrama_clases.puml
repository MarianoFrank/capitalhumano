    class CandidatoController <<Controller>> {
        + obtenerPaginados(nombre: String, apellido: String, numeroCandidato: Long, pageable: Pageable): ResponseEntity<Page<CandidatoDTO.Resumen>>
        + importarCsv(archivo: MultipartFile, file: MultipartFile): ResponseEntity<List<CandidatoDTO.Resumen>>
