        + buscar(nombre: String, apellido: String, numeroCandidato: Long): void
        + seleccionarCandidatos(idsCandidatos: List<Long>): void
        + quitarCandidatos(idsCandidatos: List<Long>): void
        + siguiente(idsCandidatos: List<Long>): void
    }

    class EvaluacionCandidatosView <<View>> {
        + mostrar(idsCandidatos: List<Long>): void
        + seleccionarPuesto(puestoSeleccionado: PuestoDTO.Seleccion): void
        + siguiente(): void
        + cancelar(): void
        + finalizar(): void
        + exportarExcel(): void
    }

    class CuestionarioView <<View>> {
        + ingresarAlCuestionario(): void
        + cancelar(): void
        + aceptar(): void
        + seleccionarOpcion(idItemPregunta: Long, idOpcion: Long): void
        + siguienteBloque(): void
        + finalizarEvaluacion(): void
        + validarRespuestasCompletas(): Boolean
    }

    class OrdenMeritoView <<View>> {
        + abrirOrdenMerito(): void
        + cancelar(): void
        + buscar(idEmpresa: Long, nombrePuesto: String, codigo: String): void
        + emitirOrdenMerito(idPuesto: Long): void
        + seleccionarEvaluacion(idEvaluacion: Long): void
