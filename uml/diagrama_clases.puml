        + seleccionarFactor(idFactor: Long): void
        + generarConIA(contextoExtra: String): void
        + ingresarDatosPregunta(nombre: String, texto: String, descripcion: String): void
        + seleccionarTipo(tipo: TipoPregunta): void
        + agregarOpcion(ordenVisualizacion: Integer, texto: String, ponderacion: Integer): void
        + cancelar(): void
        + aceptar(): void
    }

    class BusquedaCandidatosView <<View>> {
