' ==========================================
' ENTIDADES DE DOMINIO
' ==========================================
package "Dominio" {

    interface Auditable {
        + getIdentificadorAuditoria(): Long
        + getTipoEntidad(): String
    }

    class RegistroAuditoria {
        - fechaHora: DateTime
        - tipoEntidad: String
        - idEntidadEliminada: Long
        - descripcion: String
    }

    note bottom of RegistroAuditoria
      <b>Decisión de Diseño sobre 'tipoEntidad' (String vs Enum):</b>
      Se modela como <b>String</b> en lugar de un <b>Enum</b> por:
      • <b>Desacoplamiento y OCP (Principio Abierto/Cerrado):</b>
        La auditoría es un módulo transversal. Al usar un String, el sistema puede comenzar
        a auditar nuevas entidades dinámicamente sin la necesidad de modificar y recompilar
        una enumeración centralizada cada vez que el modelo de dominio crece.
    end note

    class Consultor {
        - nombreUsuario: String
    }

    class Candidato {
        - nroCandidato: Long
        - tipoDocumento: TipoDocumento
        - nroDocumento: String
        - nombre: String
        - apellido: String
        - fechaNacimiento: Date
        - genero: Genero
        - email: String
        - escolaridad: String
        - nacionalidad: String
    }

    class Empresa {
        - nombre: String
        - fechaBaja: Date
    }

    class Puesto {
        - codigo: String
        - nombre: String
        - descripcion: String
        - fechaBaja: Date
    }

    class CompetenciaPuesto {
        - ponderacionRequerida: Integer
    }

    class Competencia {
        - codigo: String
        - nombre: String
        - descripcion: String
        - tipo: TipoCompetencia
        - fechaBaja: Date
    }

    class Factor {
        - codigo: String
        - nombre: String
        - descripcion: String
        - nroOrden: Integer
        - fechaBaja: Date
    }

    class Pregunta {
        - version: Integer
        - nombre: String
        - texto: String
        - descripcion: String
        - tipo: TipoPregunta
        - fechaModificacion: DateTime
        - fechaBaja: Date
        + Pregunta()
        + Pregunta(nombre: String, texto: String, descripcion: String, tipo: TipoPregunta, factor: Factor)
        + agregarOpcion(opcion: Opcion): void
        + getOpciones(): List<Opcion>
        + setFactor(factor: Factor): void
        + setNombre(nombre: String): void
        + setTexto(texto: String): void
        + setTipo(tipo: TipoPregunta): void
    }

    class Opcion {
        - ordenVisualizacion: Integer
        - ponderacion: Integer
        - texto: String
        + Opcion()
        + Opcion(ordenVisualizacion: Integer, texto: String, ponderacion: Integer)
    }

    class Evaluacion {
        - codigo: String
        - fechaCreacion: Date
        - fechaCierre: Date
        - duracionEnMinutos: Integer
        - duracion: Integer
        - cantPreguntasPorBloque: Integer
        + Evaluacion()
        + Evaluacion(codigo: String, puesto: Puesto, consultor: Consultor, duracionEnMinutos: Integer, cantPreguntasPorBloque: Integer)
        + agregarCuestionario(cuestionario: Cuestionario): void
        + setCodigo(codigo: String): void
        + setPuesto(puesto: Puesto): void
        + setConsultor(consultor: Consultor): void
        + setDuracion(duracion: Integer): void
        + setCantPreguntasPorBloque(cantPreguntasPorBloque: Integer): void
    }

    class Cuestionario {
        - claveIngreso: String
        - claveAcceso: String
        - fechaHoraInicio: Date
        - fechaInicio: LocalDateTime
        - fechaHoraFin: Date
        - fechaFin: LocalDateTime
        - ultimoIngreso: Date
        - ultimoAcceso: LocalDateTime
        - cantidadAccesos: Integer
        - puntajeTotal: Double
        - estado: EstadoCuestionario
        + Cuestionario()
        + Cuestionario(candidato: Candidato, claveIngreso: String, estado: EstadoCuestionario)
        + agregarBloque(bloque: Bloque): void
        + getPuntajesCompetencias(): List<PuntajeCompetencia>
        + setEvaluacion(evaluacion: Evaluacion): void
        + setCandidato(candidato: Candidato): void
        + setClaveAcceso(claveAcceso: String): void
        + setEstado(estado: EstadoCuestionario): void
        + setFechaInicio(fechaInicio: LocalDateTime): void
        + setFechaFin(fechaFin: LocalDateTime): void
        + setCantidadAccesos(cantidadAccesos: Integer): void
        + setUltimoAcceso(ultimoAcceso: LocalDateTime): void
        + setPuntajeTotal(puntajeTotal: Double): void
    }

    class Bloque {
        - nroBloque: Integer
        - numeroBloque: Integer
        + Bloque()
        + Bloque(nroBloque: Integer)
        + agregarItemPregunta(item: ItemPregunta): void
    }

    class ItemPregunta {
        - ordenVisualizacion: Integer
        - puntajeObtenido: Double
        + ItemPregunta()
        + ItemPregunta(pregunta: Pregunta, ordenVisualizacion: Integer)
        + agregarItemOpcion(itemOpcion: ItemOpcion): void
    }

    class ItemOpcion {
        - respondido: Boolean
        - estaRespondida: Boolean
        + ItemOpcion()
        + ItemOpcion(opcion: Opcion)
        + setEstaRespondida(estaRespondida: Boolean): void
    }

    class PuntajeCompetencia {
        - puntaje: Double
        + PuntajeCompetencia()
        + PuntajeCompetencia(competencia: Competencia)
        + getPuntajesFactores(): List<PuntajeFactor>
        + setPuntaje(puntaje: Double): void
    }

    class PuntajeFactor {
        - puntaje: Double
        + PuntajeFactor()
        + PuntajeFactor(factor: Factor, puntaje: Double)
    }
}

